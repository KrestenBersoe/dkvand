# ═══════════════════════════════════════════════════════════════════════════
# .dockerignore — reducerer build-context-uploaden til Depot-builderen
# ═══════════════════════════════════════════════════════════════════════════
#
# RETTET: Dockerfile'en er skiftet fra en fil-for-fil COPY-liste til
# `COPY . .` (se dens egen begrundelse — den gamle liste var netop hvad der
# forårsagede gentagne "Cannot find module"-produktionsudfald, når en ny
# lokal fil blev glemt i listen). Denne fil har derfor nu den MODSATTE
# opgave af før: den er den ENESTE ting, der forhindrer node_modules/,
# scripts/, tileserver/ m.fl. (til sammen adskillige GB) i at blive bagt ind
# i imaget. Et mønster her, der uforvarende rammer en fil serveren rent
# faktisk kræver ved opstart (require()) eller læser via fs/express.static
# runtime, giver samme klasse produktionsudfald som den gamle manglende-
# COPY-linje-fejl — bare opdaget SENERE (ved runtime, ikke ved build).
# ═══════════════════════════════════════════════════════════════════════════

# Node-afhængigheder — Dockerfile'en installerer sin EGEN kopi via
# `RUN npm ci --omit=dev` fra package.json/package-lock.json. Den
# lokale node_modules/ er derfor ren spildt upload, aldrig brugt.
node_modules/

# Data-pipeline-scripts (~4,1 GB) — offline forbehandling (fetch/build/
# calibrate/id15-terrænmodel m.fl.), køres LOKALT af udvikleren for at
# PRODUCERE de færdige JSON/geojson-filer serveren rent faktisk læser
# (badevand-analyseresultater.json, id15-lake-matches.json, osv.) — selve
# scripts-koden er aldrig en runtime-afhængighed for server.js.
scripts/

# Retiret selvhostet tileserver-opsætning (~1,3 GB, mest font-/cache-data
# under tileserver/) — erstattet af coverage.pmtiles (se TILES_DIR/
# '/tiles'-routen i server.js), ikke længere en del af denne app.
tileserver/

# coverage.pmtiles (~5,5 GB) uploades manuelt til Fly-Volumen via
# build-tiles.sh + fly ssh sftp put — ALDRIG en del af imaget/git. Ligger
# lokalt her under tiles/ under udvikling (TILES_DIR falder tilbage til
# __dirname/tiles, når /data ikke findes).
tiles/

# Fejlagtigt tidligere committet lokal kopi/backup af den kørende
# produktions-app (server.js m.fl. duplikeret i en undermappe) — ikke en
# del af selve appens filstruktur, må ALDRIG bages ind i imaget.
dkvand-live/

# Retirerede engangs-diagnose-scripts — ikke en runtime-afhængighed.
archive/

# Versionsstyrings-/build-/deploy-metadata — aldrig brug for den i imaget.
.git/
.gitignore
.dockerignore
.env
Dockerfile
fly.toml

# Claude Code-projektindstillinger — lokalt udviklingsværktøj, ikke en
# del af den kørende app (og kan indeholde lokale permission-noter, se
# .gitignore's egen begrundelse for hvorfor denne fil aldrig committes).
.claude/

# NYT (produktionsudfald 2026-08-14 — se Dockerfile's tilsvarende
# kommentar): denne mappe eksisterer kun for at badested-observations.js
# kan oprette den RUNTIME på Fly-volumen (fs.mkdirSync(..., {recursive:
# true})) — en lokalt eksisterende (evt. test-)version her må ALDRIG
# bages ind i et frisk image, uafhængigt af build-context-størrelse.
observation-photos/

# Automatiske puls-data-backups (samme mønster/begrundelse som
# .gitignore's egen regel for disse — tidsstemplet i filnavnet, ikke
# kildedata, regenereres løbende af opdaterings-scripts).
puls-data.bak-*.json
