# Dependencies — reinstallable via package.json/package-lock.json
node_modules/

# Genererede tile-cachefiler — store binære/rå datasæt, ikke kildekode
# (scripts/tiles: ~4,0 GB, tileserver/data: ~1,3 GB). Regenereres af
# tileserver-opsætningen, hører ikke til i versionsstyring.
scripts/tiles/
tileserver/data/

# Automatiske puls-data-backups (skrevet af update-puls.js/opdaterings-
# scripts ved hver kørsel, tidsstemplet i filnavnet) — ikke kildedata.
puls-data.bak-*.json

# Fuld prøvehistorik (scripts/build-badevand-analyseresultater.js's
# OUT_SAMPLES_FILE) — i modsætning til badevand-analyseresultater.json
# ovenfor (som ER committet, den kørende app henter den direkte) er denne
# et rent offline valideringsingrediens til scripts/validate-predictions*.js
# (samme mønster som frwater's gitignorede bathing-water-samples.json):
# flere hundrede tusinde rækker, aldrig læst af den kørende server, og
# regenereres lokalt fra en manuel PULS-CSV-eksport ved behov.
badevand-proeve-historik.json

# NYT (bruger-rapporteret 2026-09-04): rå kilde-CSV til scripts/build-
# badevand-analyseresultater.js (samme "aldrig læst af den kørende
# server, kun offline byggeingrediens"-princip som badevand-proeve-
# historik.json ovenfor) — scriptet accepterer den direkte i STATIC_DIR
# (repo-roden) som en bekvemmelighed, men den hører ikke hjemme i
# versionsstyring, endsige i Docker-imaget (se .dockerignore).
*.csv
puls_vBadevandsstationResultater_csv.zip

# Lokale miljøvariabler/hemmeligheder (DATABASE_URL, VAPID-nøgler m.fl. —
# sættes via `fly secrets`, ikke committet).
.env
.env.*

# Python cache
__pycache__/
*.pyc

# Claude Code lokal permissions-/settings-fil — IKKE til versionsstyring:
# permission-allowlisten kan indeholde fulde kommandotekster verbatim,
# inklusive evt. hemmeligheder skrevet inline i tidligere godkendte
# kommandoer (fx "export TOKEN=...", "KEY=... python3 ..."). Opdaget
# 2026-08-12: indeholdt et Cloudflare API-token og R2-adgangsnøgler i
# klartekst — fjernet fra det første commit, roter disse hvis de er brugt
# til noget reelt.
.claude/settings.local.json
